+                  const posix_spawnattr_t* attrs,
+                  char* const argv[],
+                  char* const envp[],
+                  std::string_view search_path) {
+  if (file == nullptr || file[0] == '\0') return ENOENT;
+  if (std::strchr(file, '/') != nullptr) {
+    int spawn_error;
+    do {
