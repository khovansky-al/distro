-            nullptr,
-            result);
-        if (status != napi_ok)
-            std::free(data);
+        void *data = nullptr;
+        napi_status status = napi_create_arraybuffer(env, length, &data, result);
+        if (status == napi_ok && zero_fill && length > 0)
+            std::memset(data, 0, length);
         return status;
     }
