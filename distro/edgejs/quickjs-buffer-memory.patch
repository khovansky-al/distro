diff --git a/napi/quickjs/src/js_native_api_quickjs.cc b/napi/quickjs/src/js_native_api_quickjs.cc
index dc09195..0dc1cb2 100644
--- a/napi/quickjs/src/js_native_api_quickjs.cc
+++ b/napi/quickjs/src/js_native_api_quickjs.cc
@@ -378,5 +378,19 @@ extern "C"
     auto rt = JS_GetRuntime(env->context());
     auto buf = js_malloc_rt(rt, byte_length);
+    if (buf == nullptr && byte_length > 0)
+    {
+      // ArrayBuffer backing stores account toward QuickJS's heap, but this
+      // allocation happens before the JS object allocation that normally
+      // checks the GC threshold. Retry once after collecting dead buffers and
+      // cycles before reporting a real process OOM.
+      JS_RunGC(rt);
+      buf = js_malloc_rt(rt, byte_length);
+      if (buf == nullptr)
+      {
+        JS_ThrowOutOfMemory(env->context());
+        return napi_pending_exception;
+      }
+    }
     if (data != nullptr)
     {
       *data = buf;
