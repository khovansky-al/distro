+// A user finalizer queued out of the garbage collector's cycle sweep.
+struct PendingFinalizer
+{
+  napi_external_backing_store_hint__ *hint;
+  // Captured when the hint is queued. Nothing runs between the sweep and the
+  // drain, so is_detaching() cannot change in between; deciding here keeps the
+  // drain faithful to the immediate path it replaced.
+  bool destroy_after_invoke;
+};
+
+struct PendingFinalizerQueue
+{
+  std::vector<PendingFinalizer> items;
+  // Set while this runtime's drain invokes user callbacks. A callback may
+  // allocate, start another collection, and re-enter the drain; the re-entrant
+  // pass returns immediately and the loop below drains what it queued.
+  bool draining = false;
+};
+
+std::mutex g_pending_finalizers_mutex;
+std::unordered_map<JSRuntime *, PendingFinalizerQueue> g_pending_finalizers;
+
+void queue_pending_finalizer(JSRuntime *rt,
+                             napi_external_backing_store_hint__ *hint,
+                             bool destroy_after_invoke)
+{
+  std::lock_guard<std::mutex> lock(g_pending_finalizers_mutex);
+  g_pending_finalizers[rt].items.push_back(PendingFinalizer{hint, destroy_after_invoke});
+}
+
+// JS_GC epilogue: the collection has completed and gc_phase is back to
+// JS_GC_PHASE_NONE, so it is safe to call into N-API. This is where the user's
+// finalizer callbacks actually run -- the same contract V8-based Node gives
+// them. QuickJS would otherwise run them from inside gc_free_cycles, where a
+// finalizer resolving a weak napi_ref (napi_get_reference_value) dups a value
+// the collector has condemned; the object then survives the sweep on
+// gc_zero_ref_count_list and the handle scope that received it frees it a
+// second time.
+void drain_pending_finalizers(JSRuntime *rt, void *opaque, bool runtime_teardown)
+{
+  (void)opaque;
+  PendingFinalizerQueue *queue = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_pending_finalizers_mutex);
+    auto it = g_pending_finalizers.find(rt);
+    if (it == g_pending_finalizers.end())
+      return;
+    queue = &it->second;
+    if (queue->draining)
+      return;
+    queue->draining = true;
+  }
+
+  std::vector<PendingFinalizer> batch;
+  for (;;)
+  {
+    batch.clear();
+    {
+      std::lock_guard<std::mutex> lock(g_pending_finalizers_mutex);
+      batch.swap(queue->items);
+    }
+    if (batch.empty())
+      break;
+    for (const auto &pending : batch)
+    {
+      pending.hint->invoke_finalizer();
+      if (pending.destroy_after_invoke)
+        napi_external_backing_store_hint__::destroy_with_runtime(rt, pending.hint);
+    }
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(g_pending_finalizers_mutex);
+    queue->draining = false;
+    if (runtime_teardown)
+      g_pending_finalizers.erase(rt);
+  }
+}
